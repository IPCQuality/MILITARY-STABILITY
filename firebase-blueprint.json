{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil akun Pengawas, Supervisor, dan Admin tanpa shift tetap karena rolling mingguan.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID pengguna.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email pengguna terdaftar.",
          "minLength": 3,
          "maxLength": 200
        },
        "fullName": {
          "type": "string",
          "description": "Nama lengkap pengawas, supervisor, atau admin.",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Peran akses pengguna.",
          "enum": ["pengawas", "supervisor", "admin"]
        },
        "canEditAll": {
          "type": "boolean",
          "description": "Flag izin edit semua laporan lintas shift (khusus supervisor/admin)."
        },
        "approvalStatus": {
          "type": "string",
          "description": "Status persetujuan pendaftaran oleh Admin.",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan profil dari server.",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan profil dari server.",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "email",
        "fullName",
        "role",
        "canEditAll",
        "createdAt",
        "updatedAt"
      ]
    },
    "HandoverReport": {
      "title": "HandoverReport",
      "description": "Laporan serah terima pekerjaan antar-shift MILITARY & STABILITY.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik dokumen laporan handover.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "description": "Lingkup plant handover.",
          "enum": ["military-stability"]
        },
        "reportDate": {
          "type": "string",
          "description": "Tanggal operasional laporan (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "shift": {
          "type": "string",
          "description": "Shift kerja laporan.",
          "enum": ["Shift 1", "Shift 2", "Shift 3"]
        },
        "category": {
          "type": "string",
          "description": "Kategori pekerjaan handover.",
          "enum": [
            "OVERHAUL",
            "STABILITY TINGGI",
            "CASE PERBAIKAN PART",
            "COMMISSIONING / TRIAL / CHANGE OVER"
          ]
        },
        "machine": {
          "type": "string",
          "description": "Kode/nama mesin yang dilaporkan.",
          "minLength": 1,
          "maxLength": 64
        },
        "information": {
          "type": "string",
          "description": "Update shift/informasi/keterangan pekerjaan.",
          "minLength": 1,
          "maxLength": 2000
        },
        "followUp": {
          "type": "string",
          "description": "Rencana tindak lanjut untuk shift berikutnya.",
          "minLength": 0,
          "maxLength": 2000
        },
        "palletLocation": {
          "type": "string",
          "description": "Lokasi palet atau komponen terkait.",
          "minLength": 0,
          "maxLength": 200
        },
        "isCompleted": {
          "type": "boolean",
          "description": "Status selesai (OK) untuk menutup case di dashboard."
        },
        "isRepairStart": {
          "type": "boolean",
          "description": "Penanda apakah shift ini merupakan hari pertama perbaikan (awal perhitungan Total Durasi)."
        },
        "activityStage": {
          "type": "string",
          "description": "Tahapan pekerjaan: OH (belum mulai perbaikan / standby), REPAIR (perbaikan setting), MILITARY (ambil military), atau STABILITY (uji kestabilan).",
          "enum": ["OH", "REPAIR", "MILITARY", "STABILITY"]
        },
        "militaryRound": {
          "type": "integer",
          "description": "Nomor pengambilan sampel military dalam satu case (1, 2, dst).",
          "minimum": 1,
          "maximum": 50
        },
        "militaryStatus": {
          "type": "string",
          "description": "Hasil uji military: PENDING (belum diuji), OK (0% bocor), atau LEAK (bocor).",
          "enum": ["PENDING", "OK", "LEAK"]
        },
        "militaryLeakBoxes": {
          "type": "integer",
          "description": "Jumlah box bocor saat pengambilan military jika gagal.",
          "minimum": 0,
          "maximum": 500
        },
        "stabilityPhase": {
          "type": "string",
          "description": "Fase pengujian stability: 4_HOURS (khusus overhaul) atau 8_HOURS.",
          "enum": ["4_HOURS", "8_HOURS"]
        },
        "stabilityStatus": {
          "type": "string",
          "description": "Hasil uji stability: PENDING (belum diuji), OK (lolos stabil), atau LEAK (bocor/deviasi).",
          "enum": ["PENDING", "OK", "LEAK"]
        },
        "leakLine": {
          "type": "string",
          "description": "Line atau nozzle yang bocor saat uji Military atau Stability (contoh: PH L1 / PV L1N2).",
          "minLength": 0,
          "maxLength": 200
        },
        "createdBy": {
          "type": "string",
          "description": "UID pembuat laporan asli.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "description": "Nama pembuat laporan asli.",
          "minLength": 1,
          "maxLength": 120
        },
        "updatedBy": {
          "type": "string",
          "description": "UID pengguna terakhir yang memperbarui laporan.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "description": "Nama pengguna terakhir yang memperbarui laporan.",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan dokumen dari server.",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan dokumen dari server.",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "workspaceId",
        "reportDate",
        "shift",
        "category",
        "machine",
        "information",
        "followUp",
        "palletLocation",
        "isCompleted",
        "createdBy",
        "createdByName",
        "updatedBy",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Koleksi privat profil pengguna beserta role (pengawas/supervisor/admin)."
    },
    "/handover_reports/{reportId}": {
      "schema": { "$ref": "#/entities/HandoverReport" },
      "description": "Koleksi laporan handover lintas shift untuk dashboard, history, dan export Excel."
    }
  }
}
